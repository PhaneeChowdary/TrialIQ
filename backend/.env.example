# TrialIQ settings. Every value has a default: with no .env the app runs fully local with Ollama.
TRIALIQ_OLLAMA_URL=http://127.0.0.1:11434
TRIALIQ_LOCAL_MODEL=qwen3:8b

# Optional free cloud models for the protocol agents (no patient data): criteria, terminology, LOINC mapping.
# Groq: console.groq.com/keys    Gemini: aistudio.google.com/apikey
TRIALIQ_GROQ_API_KEY=
TRIALIQ_GROQ_MODEL=openai/gpt-oss-120b
TRIALIQ_GEMINI_API_KEY=
TRIALIQ_GEMINI_MODEL=gemini-3.5-flash

# Patient notes go to the local model only. "on" also lets the cloud models above read them.
# The demo data is synthetic. With real data this needs a BAA and an approval of the privacy office.
TRIALIQ_CLOUD_PHI=off

# Screening
TRIALIQ_SCREEN_DATE=2026-10-01
TRIALIQ_CONCURRENCY=1
TRIALIQ_CHART_ROUNDS=4
TRIALIQ_RUN_TIME_LIMIT_SECONDS=3600
# true: approved referrals are recorded, nothing is sent
TRIALIQ_DRY_RUN=true
